{
  "seed": 7,
  "algo": {
    "name": "a2c_discrete"
  },
  "model": {
    "name": "discrete_a2c"
  },
  "network": {
    "name": "token_set",
    "separate": false,
    "space": {
      "discrete": null
    },
    "mlp": {
      "units": [
        256,
        128,
        64
      ],
      "activation": "elu",
      "d2rl": false,
      "initializer": {
        "name": "default"
      },
      "regularizer": {
        "name": "None"
      }
    },
    "token_set": {
      "nTokens": 11,
      "tokenDim": 8,
      "embed": 64,
      "layers": 2,
      "studentCompat": true
    },
    "rnn": {
      "name": "gru",
      "units": 256,
      "layers": 1,
      "before_mlp": false,
      "concat_input": true,
      "layer_norm": false
    }
  },
  "load_checkpoint": true,
  "load_path": "teacher_ep210.pth",
  "config": {
    "name": "trace-teacher",
    "env_name": "rlgpu",
    "multi_gpu": false,
    "ppo": true,
    "mixed_precision": false,
    "normalize_input": true,
    "normalize_value": true,
    "num_actors": 64,
    "reward_shaper": {
      "scale_value": 1.0
    },
    "normalize_advantage": true,
    "gamma": 0.99,
    "tau": 0.95,
    "learning_rate": 0.00015,
    "lr_schedule": "adaptive",
    "kl_threshold": 0.008,
    "score_to_win": 150,
    "max_epochs": 3000,
    "save_best_after": 15,
    "save_frequency": 15,
    "print_stats": true,
    "grad_norm": 1.0,
    "entropy_coef": 0.01,
    "truncate_grads": true,
    "e_clip": 0.2,
    "horizon_length": 128,
    "minibatch_size": 4096,
    "mini_epochs": 8,
    "critic_coef": 4,
    "clip_value": true,
    "seq_len": 32,
    "bounds_loss_coef": 0.0001
  }
}
