# Copy to trace.env and `source` it, or export these yourself.
export TRACE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export TRACE_DATA="$TRACE_ROOT/data"
export TRACE_RUNS="$TRACE_ROOT/runs"
# export TRACE_PYTHON=/path/to/env/bin/python   # interpreter for child processes
